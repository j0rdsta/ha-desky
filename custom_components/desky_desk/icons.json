{
  "entity": {
    "button": {
      "move_down": {
        "default": "mdi:arrow-down-bold"
      },
      "move_up": {
        "default": "mdi:arrow-up-bold"
      },
      "preset": {
        "default": "mdi:bookmark-outline"
      }
    },
    "cover": {
      "desk": {
        "default": "mdi:desk"
      }
    },
    "light": {
      "desk_light": {
        "default": "mdi:led-strip-variant",
        "state": {
          "off": "mdi:led-strip-variant-off"
        }
      }
    },
    "number": {
      "height": {
        "default": "mdi:arrow-expand-vertical"
      },
      "height_limit_lower": {
        "default": "mdi:arrow-collapse-down"
      },
      "height_limit_upper": {
        "default": "mdi:arrow-collapse-up"
      },
      "vibration_intensity": {
        "default": "mdi:vibrate"
      }
    },
    "select": {
      "sensitivity": {
        "default": "mdi:car-brake-alert"
      },
      "touch_mode": {
        "default": "mdi:gesture-tap"
      },
      "unit": {
        "default": "mdi:ruler"
      }
    },
    "sensor": {
      "height_display": {
        "default": "mdi:arrow-expand-vertical"
      },
      "posture": {
        "default": "mdi:human-male",
        "state": {
          "sitting": "mdi:chair-rolling",
          "standing": "mdi:human-handsdown"
        }
      },
      "sitting_time_today": {
        "default": "mdi:chair-rolling"
      },
      "standing_time_today": {
        "default": "mdi:human-handsdown"
      }
    },
    "switch": {
      "lock": {
        "default": "mdi:lock",
        "state": {
          "off": "mdi:lock-open-variant"
        }
      },
      "vibration": {
        "default": "mdi:vibrate",
        "state": {
          "off": "mdi:vibrate-off"
        }
      }
    }
  },
  "services": {
    "clear_height_limits": {
      "service": "mdi:arrow-expand-vertical"
    },
    "move_to_height": {
      "service": "mdi:human-male-height-variant"
    },
    "set_height_limit": {
      "service": "mdi:arrow-collapse-vertical"
    }
  }
}
